# Local demo mode (never enabled implicitly in production)
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
DEMO_ORGANIZATION_ID=org_demo
DEMO_USER_ID=user_demo
# Optional durable location for committed demo workers/runs/approvals.
# Open builder sessions remain in-process in demo mode.
# AGENTCLOUD_DEMO_DATA_PATH=.agentcloud/demo-store.json

# PostgreSQL / Neon
DATABASE_URL=postgresql://agentcloud:agentcloud@localhost:5432/agentcloud

# Clerk web auth and OAuth provider for MCP
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_FRONTEND_API_URL=

# Models
OPENAI_API_KEY=
# Used by both the production builder/compiler and worker runner.
WORKER_MODEL=gpt-5-mini

# Trigger.dev v4
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
TRIGGER_PREVIEW_BRANCH=

# Composio (OAuth tokens stay in Composio)
# Managed fallback for capabilities not currently exposed by an official MCP server
# (notably Gmail send_email and Slack channel listing).
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_HUBSPOT=
COMPOSIO_AUTH_CONFIG_SLACK=

# Official provider remote MCP OAuth. Generate the encryption key with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Register the exact callback https://YOUR_DOMAIN/api/integrations/callback.
MCP_CONNECTION_ENCRYPTION_KEY=
MCP_GMAIL_CLIENT_ID=
MCP_GMAIL_CLIENT_SECRET=
MCP_HUBSPOT_CLIENT_ID=
MCP_HUBSPOT_CLIENT_SECRET=
MCP_SLACK_CLIENT_ID=
MCP_SLACK_CLIENT_SECRET=

# Application origin. Production must use canonical HTTPS. This is used for
# Composio callbacks and MCP dashboard continuation links, which never embed credentials.
APP_BASE_URL=http://localhost:3000
# At least 32 random bytes; used for raw-body HMAC-SHA256 webhook verification
WEBHOOK_SIGNING_SECRET=
LOG_LEVEL=info
