    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "trigger:dev": "pnpm dlx trigger.dev@4.5.10 dev",
    "trigger:deploy": "pnpm dlx trigger.dev@4.5.10 deploy"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.41",
    "@clerk/mcp-tools": "0.6.0",
    "@clerk/nextjs": "7.7.4",
